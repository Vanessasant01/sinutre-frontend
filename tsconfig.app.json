{
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    
   "baseUrl": ".",
"ignoreDeprecations": "5.0",
"paths": {
  "@/*": ["src/*"]
}
  },
  "include": ["src"]
}